        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class app_streamlit_UI {\n        Streamlit UI — điều phối toàn bộ giao diện\n    }\n    class UnifiedDermatologyPipeline {\n        Controller trung tâm — điều phối luồng chẩn đoán\n    }\n    class SafetyGate {\n        Đánh giá chất lượng &amp; độ tin cậy kết quả\n    }\n    class InteractiveSegmenter {\n        Phân đoạn tổn thương (SAM / GrabCut / DeepLabV3+)\n    }\n    class MultimodalBayesianFusion {\n        Hợp nhất xác suất ảnh với dịch tễ\n    }\n    class EHR_Functions {\n        Mã hóa &amp; lưu trữ hồ sơ bệnh án\n    }\n\n    app_streamlit_UI --&gt; UnifiedDermatologyPipeline : gọi để chẩn đoán\n    app_streamlit_UI --&gt; EHR_Functions : gọi để lưu hồ sơ\n    UnifiedDermatologyPipeline --&gt; SafetyGate : dùng để hậu kiểm\n    UnifiedDermatologyPipeline --&gt; InteractiveSegmenter : dùng để phân đoạn\n    UnifiedDermatologyPipeline --&gt; MultimodalBayesianFusion : dùng để phân loại + fusion\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DZa7KQ7awYXrDtbj9f_J-319">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontFamily=Helvetica;fontSize=22;" vertex="1">
            <mxGeometry height="3150" width="4042" as="geometry" />
