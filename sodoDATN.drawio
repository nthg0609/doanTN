        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    A[\&quot;Ảnh da đầu vào (RGB / DICOM)\&quot;] --&gt; B{\&quot;Tách Nhánh Song Song\&quot;}\n\n    subgraph N1 [\&quot;Nhánh 1: Phân đoạn &amp; Chỉ số ABCD\&quot;]\n        N1S[\&quot;Phân đoạn tổn thương (SAM / DeepLabV3+ / OTSU dự phòng)\&quot;]\n        N1M[\&quot;Đo đạc chỉ số hình học ABCD (Asymmetry, Border, Color, Diameter)\&quot;]\n        N1S --&gt; N1M\n    end\n\n    subgraph N2 [\&quot;Nhánh 2: Phân loại &amp; Dịch tễ\&quot;]\n        N2S[\&quot;Phân loại ảnh (EfficientNet-B1 + CBAM)\&quot;]\n        N2F[\&quot;Late Fusion Bayes (Hợp nhất xác suất với Tuổi, Giới tính, Vị trí)\&quot;]\n        N2S --&gt; N2F\n    end\n\n    B --&gt; N1S\n    B --&gt; N2S\n\n    N1M --&gt; G[\&quot;Safety Gate&lt;br/&gt;(đánh giá sau khi cả 2 nhánh đã có kết quả)\&quot;]\n    N2F --&gt; G\n\n    G -- \&quot;Không đạt\&quot; --&gt; R[\&quot;Yêu cầu chụp lại&lt;br/&gt;(Triage)\&quot;]\n    G -- \&quot;Đạt &amp; Bệnh lý ác tính\&quot; --&gt; W[\&quot;Cảnh báo chuyển tuyến cấp thiết&lt;br/&gt;(Triage)\&quot;]\n    G -- \&quot;Đạt &amp; Lành tính / Tham vấn\&quot; --&gt; V[\&quot;Trợ lý đàm thoại VQA y văn RAG&lt;br/&gt;(DistilGPT-2 LoRA)\&quot;]\n\n    W --&gt; E[\&quot;Lưu trữ CSDL Firestore EHR &amp;&lt;br/&gt;Xuất báo cáo PDF\&quot;]\n    V --&gt; E\n\n    classDef inputBox fill:#FFFFFF,stroke:#8B1A2B,stroke-width:1.5px,color:#000000\n    classDef stepNode fill:#E8ECF7,stroke:#555555,stroke-width:1px,color:#000000\n    classDef diamond fill:#8B1A2B,stroke:#5C0E19,stroke-width:1.5px,color:#FFFFFF,font-weight:bold\n    classDef gateBox fill:#FFFFFF,stroke:#8B1A2B,stroke-width:1.5px,color:#000000\n    classDef triageBox fill:#8B1A2B,stroke:#5C0E19,stroke-width:1.5px,color:#FFFFFF,font-weight:bold\n    classDef outBox fill:#FFFFFF,stroke:#8B1A2B,stroke-width:1.5px,color:#000000\n\n    class A inputBox\n    class N1S,N1M,N2S,N2F stepNode\n    class B diamond\n    class G gateBox\n    class R,W triageBox\n    class V,E outBox\n    style N1 fill:#FDF3C7,stroke:#B8860B,stroke-width:1px\n    style N2 fill:#FDF3C7,stroke:#B8860B,stroke-width:1px\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DZa7KQ7awYXrDtbj9f_J-209">
